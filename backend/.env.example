PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SERVE_CLIENT=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=junubsoftflow

SESSION_SECRET=change-me-to-a-long-random-string

# upload ceilings, in MB (restart the API after changing)
MAX_APK_MB=2048
MAX_FILE_MB=4096
MAX_BUNDLE_TOTAL_MB=1024

# HTTP Basic auth for API clients (Postman, curl, CI).
# Credentials ride on every request, so this defaults to ON in development and OFF in
# production. Set true only if production is served over HTTPS.
ALLOW_BASIC_AUTH=true

# Outgoing email. Credentials are secrets, so they live here rather than in the
# settings table; the visible from-name and reply-to are edited in Settings -> Email.
# Leave SMTP_HOST blank and the app sends nothing and says so - it never pretends.
# Gmail: smtp.gmail.com / 587 / an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Used for the links inside emails, which cannot be relative.
PUBLIC_URL=https://your-store.example
